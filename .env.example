# ==============================================================================
# StaleGuard Environment Configuration Template
# Copy this file to .env and fill in your actual API keys.
# ==============================================================================

# --- Maxim Bifrost AI Gateway Configuration ---
# Bifrost documentation: https://github.com/maximhq/bifrost
# Standard local Bifrost gateway runs on http://localhost:8080/v1
BIFROST_BASE_URL=http://localhost:8080/v1
BIFROST_API_KEY=your_bifrost_or_llm_provider_key_here
BIFROST_MODEL=gpt-4o-mini
BIFROST_TIMEOUT=45
BIFROST_MAX_RETRIES=3

# --- Tavily Live Internet Search API ---
# Get your API key from: https://app.tavily.com/
TAVILY_API_KEY=tvly-your_actual_tavily_api_key_here
TAVILY_SEARCH_DEPTH=advanced
TAVILY_MAX_RESULTS=5
TAVILY_TIMEOUT=20
TAVILY_MAX_RETRIES=3

# --- Application Mode Settings ---
# Set to 'true' to force offline curated demo mode with pre-cached real-world audits
DEMO_MODE=false
