"""
StaleGuard - Bifrost AI Gateway Client Module
Provides a unified interface to the Bifrost AI Gateway (https://github.com/maximhq/bifrost).
Supports OpenAI-compatible routing, multi-model fallback, rate-limit retries,
timeout management, and graceful fallback when credentials are not configured.
"""

import time
import json
import logging
import requests
from typing import Dict, Any, List, Optional
from config import config
from utils import extract_json_from_llm_response, sanitize_for_prompt_injection

logger = logging.getLogger("deStale.BifrostClient")


class BifrostAPIError(Exception):
    """Custom exception raised for Bifrost AI Gateway failures."""
    def __init__(self, message: str, status_code: Optional[int] = None, details: Optional[str] = None):
        super().__init__(message)
        self.status_code = status_code
        self.details = details


class BifrostClient:
    """
    Client for interacting with the Bifrost AI Gateway.
    Bifrost routes AI requests across LLM providers with automatic fallback,
    latency tracking, and standardized OpenAI-compatible payloads.
    """

    def __init__(
        self,
        base_url: Optional[str] = None,
        api_key: Optional[str] = None,
        model: Optional[str] = None,
        timeout: Optional[int] = None,
        max_retries: Optional[int] = None,
    ):
        self.base_url = (base_url or config.BIFROST_BASE_URL).rstrip("/")
        # Ensure endpoint has standard /chat/completions suffix
        if not self.base_url.endswith("/v1"):
            # If user provided host like http://localhost:8080 without /v1
            if not self.base_url.endswith("/chat/completions"):
                self.chat_endpoint = f"{self.base_url}/v1/chat/completions"
            else:
                self.chat_endpoint = self.base_url
        else:
            self.chat_endpoint = f"{self.base_url}/chat/completions"

        self.api_key = api_key or config.BIFROST_API_KEY
        self.model = model or config.BIFROST_MODEL
        self.timeout = timeout or config.BIFROST_TIMEOUT
        self.max_retries = max_retries or config.BIFROST_MAX_RETRIES

    def check_health(self) -> Dict[str, Any]:
        """
        Pings the Bifrost gateway to check connectivity and readiness.
        Returns a dict with status and details.
        """
        try:
            # Check root health or /healthz or /v1/models
            health_url = self.base_url.replace("/v1", "") + "/healthz"
            response = requests.get(health_url, timeout=3)
            if response.status_code == 200:
                return {"online": True, "status": "healthy", "url": self.base_url}
        except Exception:
            pass

        # Try models endpoint
        try:
            models_url = f"{self.base_url}/models"
            headers = self._get_headers()
            resp = requests.get(models_url, headers=headers, timeout=4)
            if resp.status_code in (200, 401, 403):
                return {
                    "online": True,
                    "status": "active" if resp.status_code == 200 else "auth_required",
                    "url": self.base_url,
                }
        except Exception as e:
            return {"online": False, "error": str(e), "url": self.base_url}

        return {"online": False, "error": "Gateway unreachable", "url": self.base_url}

    def _get_headers(self) -> Dict[str, str]:
        """Constructs headers for the Bifrost Gateway request."""
        headers = {
            "Content-Type": "application/json",
            "User-Agent": "deStale-Verification-Engine/1.1",
        }
        if self.api_key:
            headers["Authorization"] = f"Bearer {self.api_key}"
        return headers

    def create_chat_completion(
        self,
        messages: List[Dict[str, str]],
        temperature: float = 0.1,
        response_format_json: bool = True,
        model_override: Optional[str] = None,
    ) -> str:
        """
        Invokes an AI model through the Bifrost Gateway with retries and timeout protection.

        Args:
            messages: List of chat message dicts (role, content)
            temperature: Sampling temperature (default 0.1 for high determinism in fact verification)
            response_format_json: If True, requests JSON object format
            model_override: Optional override for the target model

        Returns:
            The raw string response generated by the AI model.
        """
        target_model = model_override or self.model
        headers = self._get_headers()

        payload: Dict[str, Any] = {
            "model": target_model,
            "messages": messages,
            "temperature": temperature,
        }

        if response_format_json:
            payload["response_format"] = {"type": "json_object"}

        last_error = None

        for attempt in range(1, self.max_retries + 1):
            try:
                logger.info(
                    "Sending completion request to Bifrost (%s) - Attempt %d/%d",
                    self.chat_endpoint,
                    attempt,
                    self.max_retries,
                )
                response = requests.post(
                    self.chat_endpoint,
                    headers=headers,
                    json=payload,
                    timeout=self.timeout,
                )

                # Handle specific HTTP error codes
                if response.status_code == 200:
                    data = response.json()
                    choices = data.get("choices", [])
                    if not choices:
                        raise BifrostAPIError("Bifrost response contained no choices", status_code=200)

                    message = choices[0].get("message", {})
                    content = message.get("content", "")
                    if not content:
                        raise BifrostAPIError("Bifrost choice returned empty content", status_code=200)

                    return content

                elif response.status_code == 401:
                    raise BifrostAPIError(
                        "Bifrost Authentication Failed: Invalid or missing API key. "
                        "Please verify BIFROST_API_KEY in your .env file.",
                        status_code=401,
                    )
                elif response.status_code == 429:
                    logger.warning("Bifrost rate limit exceeded (HTTP 429). Retrying after backoff...")
                    time.sleep(2 * attempt)
                    continue
                elif response.status_code >= 500:
                    logger.warning("Bifrost gateway error (HTTP %d): %s", response.status_code, response.text[:200])
                    time.sleep(1.5 * attempt)
                    continue
                else:
                    raise BifrostAPIError(
                        f"Bifrost Gateway returned error HTTP {response.status_code}: {response.text[:300]}",
                        status_code=response.status_code,
                        details=response.text,
                    )

            except requests.exceptions.Timeout as e:
                logger.warning("Bifrost request timed out after %d seconds (Attempt %d)", self.timeout, attempt)
                last_error = e
                time.sleep(1)
            except requests.exceptions.ConnectionError as e:
                logger.warning("Connection to Bifrost Gateway at %s failed: %s", self.chat_endpoint, e)
                last_error = e
                time.sleep(1)
            except BifrostAPIError:
                raise
            except Exception as e:
                logger.error("Unexpected error communicating with Bifrost: %s", e)
                last_error = e

        # If loop finishes without returning
        raise BifrostAPIError(
            f"Failed to complete request through Bifrost Gateway after {self.max_retries} attempts: {last_error}"
        )
